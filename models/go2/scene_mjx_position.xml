<mujoco model="go2 scene">
  <!-- Go2 平地训练/查看场景 (plane 地面)。结构与 models/go1/scene_mjx_position.xml 一致,
       只把 include 换成 go2_mjx_position.xml。

       关键约束 (改这里时必须保持):
       1. **地面 geom 名必须是 "floor"**: go2_mjx_position.xml 的 sensor 段有
          {FR,FL,RR,RL}_floor_found (geom2="floor"), 改名会让四个足端接触传感器
          全断 -> feet_air_time / feet_slip / 奖励全废。
       2. **floor 的 priority 必须是 0** (默认): 足端 geom priority=1, 两侧优先级
          不同时取高的一方 (足端) 的参数 (condim=3/friction/solimp)。若这里写
          priority=1, 两侧同级 -> 取"最大值", 足端接触语义被改错 -> 策略崩坏。
       3. floor 在原点 z=0 且为 plane: reset 的 home keyframe 就落在这个平面上。 -->
  <include file="go2_mjx_position.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
